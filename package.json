{
  "name": "pcb-online",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:socket": "tsx server.ts",
    "build": "prisma generate && next build",
    "start": "next start",
    "start:socket": "NODE_ENV=production tsx server.ts",
    "lint": "eslint",
    "db:migrate": "prisma migrate dev",
